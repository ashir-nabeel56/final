const express = require("express");
 
const Cart = require("../models/cart");
const Order = require("../models/orders");
const authMiddleware = require("../middleware/authMiddleware");
 
const router = express.Router();
 
 
// ==================================================
// PLACE ORDER
// POST /orders
// ==================================================
router.post("/", authMiddleware, async (req, res) => {
    try {
        const userId = req.user.userId;
 
        console.log("Place order user:", userId);
 
        const cart = await Cart.findOne({
            user: userId,
        }).populate("items.product");
 
        if (!cart) {
            return res.status(400).json({
                success: false,
                message: "Cart not found",
            });
        }
 
        if (!cart.items || cart.items.length === 0) {
            return res.status(400).json({
                success: false,
                message: "Cart is empty",
            });
        }
 
        // ==========================================
        // FILTER OUT ORPHANED ITEMS
        // (product ID that no longer exists in DB,
        // e.g. after a reseed) instead of failing
        // the whole checkout
        // ==========================================
        const validItems = cart.items.filter(
            (item) => item.product
        );
 
        const hadOrphanedItems =
            validItems.length !== cart.items.length;
 
        if (validItems.length === 0) {
            return res.status(400).json({
                success: false,
                message: "Cart is empty",
            });
        }
 
        let subtotal = 0;
        const orderItems = [];
 
        for (const item of validItems) {
            const price = Number(item.product.price);
            const quantity = Number(item.quantity);
 
            if (!Number.isFinite(price) || price < 0) {
                return res.status(400).json({
                    success: false,
                    message: "Invalid product price",
                });
            }
 
            if (!Number.isInteger(quantity) || quantity < 1) {
                return res.status(400).json({
                    success: false,
                    message: "Invalid product quantity",
                });
            }
 
            subtotal += price * quantity;
 
            orderItems.push({
                product: item.product._id,
                quantity,
                price,
            });
        }
 
 
        // ==========================================
        // DISCOUNT
        // ==========================================
        const discountRate = 0.20;
 
        const discount = Number(
            (subtotal * discountRate).toFixed(2)
        );
 
 
        // ==========================================
        // DELIVERY
        // ==========================================
        const deliveryFee = subtotal > 0 ? 15 : 0;
 
 
        // ==========================================
        // TOTAL
        // ==========================================
        const totalPrice = Number(
            (subtotal - discount + deliveryFee).toFixed(2)
        );
 
 
        // ==========================================
        // CREATE ORDER
        // ==========================================
        const order = await Order.create({
            user: userId,
 
            items: orderItems,
 
            subtotal: Number(subtotal.toFixed(2)),
 
            discount,
 
            deliveryFee,
 
            totalPrice,
 
            status: "pending",
        });
 
 
        // ==========================================
        // EMPTY CART
        // ==========================================
        cart.items = [];
 
        await cart.save();
 
 
        // ==========================================
        // POPULATE ORDER
        // ==========================================
        const populatedOrder = await Order.findById(order._id)
            .populate("user", "name email")
            .populate("items.product");
 
 
        return res.status(201).json({
            success: true,
            message: hadOrphanedItems
                ? "Order placed successfully (some unavailable items were skipped)"
                : "Order placed successfully",
            order: populatedOrder,
        });
 
    } catch (error) {
        console.error("PLACE ORDER ERROR:", error);
 
        return res.status(500).json({
            success: false,
            message: "Failed to place order",
            error: error.message,
        });
    }
});
 
 
// ==================================================
// GET MY ORDERS
// GET /orders/my
// ==================================================
router.get("/my", authMiddleware, async (req, res) => {
    try {
        const orders = await Order.find({
            user: req.user.userId,
        })
            .populate("items.product")
            .sort({ createdAt: -1 });
 
        return res.status(200).json({
            success: true,
            count: orders.length,
            orders,
        });
 
    } catch (error) {
        console.error("MY ORDERS ERROR:", error);
 
        return res.status(500).json({
            success: false,
            message: "Failed to fetch orders",
            error: error.message,
        });
    }
});
 
 
